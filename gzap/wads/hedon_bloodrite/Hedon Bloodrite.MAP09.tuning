; Outdoor areas
AP-REGION { "map": "MAP09", "region": "Arrival", "keys": [] }
AP-REGION { "map": "MAP09", "region": "Portal Chamber", "keys": ["map/MAP09/Arrival"] }
AP-REGION { "map": "MAP09", "region": "Customs Office", "keys": ["map/MAP09/Portal Chamber"] }
AP-REGION { "map": "MAP09", "region": "Portal Control", "keys": ["map/MAP09/Portal Chamber"] }
AP-REGION { "map": "MAP09", "region": "Garden", "keys": ["map/MAP09/Customs Office", "map/MAP09/Portal Chamber"] }
AP-REGION { "map": "MAP09", "region": "Potion Shop", "keys": ["map/MAP09/Garden"] }
AP-REGION { "map": "MAP09", "region": "Downstream", "keys": ["map/MAP09/Garden", "flag/secret"] }
; Exit. Can actually visit right at the start if you have the crystal key...
AP-REGION { "map": "MAP09", "region": "Bridge", "keys": ["map/MAP09/Garden", "key/CrystalKey"] }

; "Outer" R&D areas
AP-REGION { "map": "MAP09", "region": "R&D Entrance", "keys": ["map/MAP09/Garden"] }
AP-REGION { "map": "MAP09", "region": "R&D SW Lab", "keys": ["map/MAP09/R&D Entrance"] }

; This area is reachable either by using the jar of acid to melt the bars
; Or by using the earth key to open the door in the north lounge
; It's the northern area east of the earth key door but west of the crystal door into high security
AP-REGION { "map": "MAP09", "region": "(medium security access)", "keys": ["map/MAP09/R&D Entrance", "key/InventoryJarOfCorrosiveAcid"] }
AP-REGION { "map": "MAP09", "region": "(medium security access)", "keys": ["map/MAP09/R&D Entrance", "key/EarthKey"] }
AP-REGION { "map": "MAP09", "region": "R&D Secure Entrance", "keys": ["map/MAP09/(medium security access)"] }
AP-REGION { "map": "MAP09", "region": "Adjunct's Office", "keys": ["map/MAP09/R&D Secure Entrance"] }
AP-REGION { "map": "MAP09", "region": "Council Room", "keys": ["map/MAP09/R&D Secure Entrance"] }
AP-REGION { "map": "MAP09", "region": "Council Room Secret", "keys": ["flag/secret", "map/MAP09/Council Room"] }
AP-REGION { "map": "MAP09", "region": "Council Room Secret Secret", "keys": ["map/MAP09/Council Room Secret", "flag/secret"] }
AP-REGION { "map": "MAP09", "region": "Kitchen", "keys": ["map/MAP09/Council Room"] }
AP-REGION { "map": "MAP09", "region": "Freezer", "keys": ["map/MAP09/Kitchen"] }

; Progression path. This is where you're meant to go once you get the earth key from midsec
; and is linear until you end up back at secure labs hall.
; trickiness: if you can get into secure labs hall using the crystal key, you can backtrack
; all the way to the sewer pit. You can't get from the sewer pit to the dorms though.
; So, the dorm is reachable ONLY with the earth key
; but the whole secure labs area is reachable either with the earth key or crystal key.
AP-REGION { "map": "MAP09", "region": "S Dorm", "keys": ["map/MAP09/R&D Entrance", "key/EarthKey"] }
AP-REGION { "map": "MAP09", "region": "(high security access)", "keys": ["map/MAP09/S Dorm"] }
AP-REGION { "map": "MAP09", "region": "(high security access)", "keys": ["map/MAP09/R&D Secure Entrance", "key/CrystalKey"] }
AP-REGION { "map": "MAP09", "region": "Secure Labs Hall", "keys": ["map/MAP09/(high security access)"] }
; Path connecting secure labs hall to Lith's camp in the sewers
AP-REGION { "map": "MAP09", "region": "Garden Hall", "keys": ["map/MAP09/Secure Labs Hall"] }
AP-REGION { "map": "MAP09", "region": "Aquarium", "keys": ["map/MAP09/Garden Hall"] }
AP-REGION { "map": "MAP09", "region": "Sewer Camp", "keys": ["map/MAP09/Aquarium"] }
; Path forward
AP-REGION { "map": "MAP09", "region": "Security Room", "keys": ["map/MAP09/Secure Labs Hall", "key/AxeKey"] }
AP-REGION { "map": "MAP09", "region": "Alchemy Lab", "keys": ["map/MAP09/Secure Labs Hall"] }
AP-REGION { "map": "MAP09", "region": "Holding Cells Hall", "keys": ["map/MAP09/Alchemy Lab"] }
AP-REGION { "map": "MAP09", "region": "Vivisection Lab", "keys": ["map/MAP09/Holding Cells Hall"] }
; Visiting the security room lets you open a bunch of doors, including one to the incubation room
AP-REGION { "map": "MAP09", "region": "Incubation Hall", "keys": ["map/MAP09/Security Room", "map/MAP09/Secure Labs Hall"] }
AP-REGION { "map": "MAP09", "region": "Weapons Testing", "keys": ["map/MAP09/Incubation Hall"] }
AP-REGION { "map": "MAP09", "region": "Firing Range", "keys": ["map/MAP09/Weapons Testing"] }
AP-REGION { "map": "MAP09", "region": "Firing Range Secret", "keys": ["map/MAP09/Firing Range", "flag/secret"] }
; The trigger for losing your weapons, and the cutscene with Lith and Tiati, is walking
; down the hall after Weapons Testing
; You then get your weapons back when entering the crystal key room, open all the various
; locked areas in the level by opening the crystal key chamber, and trigger a fight
; and the ability to leave Lith's lab by walking out of the room HOLDING THE CRYSTAL KEY.
AP-REGION { "map": "MAP09", "region": "Lith's Lab", "keys": ["map/MAP09/Weapons Testing", "weapon/FragfireGun/want", "weapon/PotionLauncher/want", "weapon/Crushbow/want", "weapon/SpikeGun/want", "weapon/Axe/want"] }
AP-REGION { "map": "MAP09", "region": "Lith's Lab", "keys": ["map/MAP09/Weapons Testing", "weapon/BearzerkAxe/want", "weapon/HatchetAndShield/want", "weapon/ForcePike/want", "weapon/FireHammer/want", "weapon/GreatAxe/want"] }
AP-REGION { "map": "MAP09", "region": "(release crystal key)", "keys": ["map/MAP09/Lith's Lab"] }
; Checks that are only revealed once you open the crystal key box
AP-REGION { "map": "MAP09", "region": "Crylance Containment", "keys": ["map/MAP09/Weapons Testing", "map/MAP09/(release crystal key)"] }
AP-REGION { "map": "MAP09", "region": "Vivisection Lab Freezer", "keys": ["map/MAP09/Vivisection Lab", "map/MAP09/(release crystal key)"] }
AP-REGION { "map": "MAP09", "region": "Holding Cells", "keys": ["map/MAP09/Holding Cells Hall", "map/MAP09/(release crystal key)"] }
AP-REGION { "map": "MAP09", "region": "Security Room Emergency Supplies", "keys": ["map/MAP09/Security Room", "flag/secret", "map/MAP09/(release crystal key)"] }
AP-XOFF {}

; This bread is mildly cursed.
; It's non-interactable on level entrance.
; When you reach the high security hall while carrying the crystal key, it is deleted (collecting the checks)
; and replaced with normal bread you can eat.
; I've marked them as unreachable because I'm not a fan of this sort of opaque action at a distance.
AP-CHECK { "id": 2558, "name": "MAP09 - Bread [1799,2056]", "pos": ["MAP09",1799,2056,-596], "unreachable": true }
AP-CHECK { "id": 2557, "name": "MAP09 - Bread [1794,2013]", "pos": ["MAP09",1794,2013,-596], "unreachable": true }
AP-CHECK { "id": 2556, "name": "MAP09 - Bread [1792,2037]", "pos": ["MAP09",1792,2037,-596], "unreachable": true }

