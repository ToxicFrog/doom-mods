; The sector from the top of the elevator to blast door 5
; contains the mess hall and security room, and via the mess hall ductwork, the barracks
AP-REGION { "map": "MAP07", "region": "Sector 6-5", "keys": ["weapon/FragfireGun/want", "weapon/Axe/want", "weapon/SpikeGun/want", "weapon/Crushbow/want", "map/MAP07/Foot of the Stairs"] }
