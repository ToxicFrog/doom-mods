AP-REGION { "map": "MAP07", "region": "Barracks Lounge", "keys": ["key/EarthKey", "map/MAP07/Entrance Hall"] }

; From blast door 4 to blast door 3
; Connects to the east forest via door 3 (and, once you have the shovel, via a tunnel
; from the archives)
AP-REGION { "map": "MAP07", "region": "Sector 4-3", "keys": ["map/MAP07/Armoury"] }
AP-REGION { "map": "MAP07", "region": "Archives", "keys": ["map/MAP07/Sector 4-3"] }

; East forest
; Top of the hill has the switches for the four ward projectors
; Towers can only be accessed via the archives tunnel once you have the shovel
; SE building gives you access to sector 2-1 via a tunnel
AP-REGION { "map": "MAP07", "region": "E Forest", "keys": ["map/MAP07/Archives", "map/MAP07/Sector 4-3"] }
