AP-REGION { "map": "MAP07", "region": "Barracks", "keys": ["map/MAP07/Barracks Bathroom"] }

; From blast door 5 to blast door 4
; Includes the big pile of crates, lets you get into the mess hall pantry from behind
; Connects to the barracks lounge and south forest via the entrance hall, but those
; are both initially locked
AP-REGION { "map": "MAP07", "region": "Sector 5-4", "keys": ["map/MAP07/N Security", "weapon/PotionLauncher/want"] }
