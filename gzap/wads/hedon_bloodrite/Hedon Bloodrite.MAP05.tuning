AP-REGION { "map": "MAP05", "region": "W Woods", "keys": ["map/MAP05/N Fortifications"] }

; Stone tower in the center of the woods
AP-REGION { "map": "MAP05", "region": "Stone Tower Grove", "keys": ["map/MAP05/N Fortifications"] }
