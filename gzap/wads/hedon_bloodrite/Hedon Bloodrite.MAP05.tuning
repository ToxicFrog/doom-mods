AP-REGION { "map": "MAP05", "region": "Stone Tower Secret", "keys": ["flag/secret", "map/MAP05/Stone Tower"] }

; Great Stump to the south
AP-REGION { "map": "MAP05", "region": "Great Stump Exterior", "keys": ["map/MAP05/W Woods"] }
