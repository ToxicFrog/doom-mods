; Portal cave to the west of GS
; Need to turn on RHQ aux power here to access some rooms in RHQ
AP-REGION { "map": "MAP05", "region": "Portal Cave Path Secret", "keys": ["map/MAP05/Great Stump Exterior", "flag/secret"] }
AP-REGION { "map": "MAP05", "region": "Portal Cave", "keys": ["map/MAP05/Great Stump Exterior", "key/VineKey"] }
AP-REGION { "map": "MAP05", "region": "Portal Control Antechamber", "keys": ["map/MAP05/Portal Cave"] }
