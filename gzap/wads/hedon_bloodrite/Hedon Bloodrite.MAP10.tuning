; Combat logic for the temple is pessimistic; in normal play you can wander around the main temple
; and both wings without problems and enemies only start spawning in once you start opening shrines
; and collecting fragments, but in AP the player might plausibly enter the level with all of the
; figurines and fragments already and trigger every ambush at once.
AP-REGION { "map": "MAP10", "region": "Entrance", "keys": [] }
AP-REGION { "map": "MAP10", "region": "Elemental Temple", "keys": ["map/MAP10/Entrance", "weapon/Crylance/want", "weapon/FragfireGun/want", "weapon/PotionLauncher/want", "weapon/Crushbow/want"] }
AP-REGION { "map": "MAP10", "region": "Elemental Temple", "keys": ["map/MAP10/Entrance", "weapon/ForcePike/want", "weapon/GreatAxe/want", "weapon/BearzerkAxe/want", "weapon/FireHammer/want"] }
AP-REGION { "map": "MAP10", "region": "Temple W Hall", "keys": ["map/MAP10/Elemental Temple"] }
AP-REGION { "map": "MAP10", "region": "Temple E Hall", "keys": ["map/MAP10/Elemental Temple"] }
; Ambush that triggers when you walk down the hall carrying the earth figurine
AP-REGION { "map": "MAP10", "region": "Temple E Hall Glass", "keys": ["key/InventoryEarthFigurine", "map/MAP10/Elemental Temple"] }
AP-REGION { "map": "MAP10", "region": "Air Shrine Entrance Secret", "keys": ["map/MAP10/Temple W Hall", "flag/secret"] }
AP-REGION { "map": "MAP10", "region": "Pillar Room", "keys": ["map/MAP10/Temple W Hall"] }

; Air shrine. Hard requires earth figurine.
AP-REGION { "map": "MAP10", "region": "Air Shrine", "keys": ["map/MAP10/Temple W Hall", "key/InventoryEarthFigurine"] }
AP-REGION { "map": "MAP10", "region": "Air Shrine Pillar Secret", "keys": ["map/MAP10/Air Shrine", "flag/secret"] }

; West wing ice caves.
; Intended path is via the air shrine after placing the earth figurine
; But you can also backdoor into it via the pillar room!
AP-REGION { "map": "MAP10", "region": "Ice Caves", "keys": ["map/MAP10/Air Shrine"] }
AP-REGION { "map": "MAP10", "region": "Ice Caves", "keys": ["map/MAP10/Pillar Room"] }

; Fire shrine. Requires water figurine; earth<->fire shortcut doesn't open until you place water.
AP-REGION { "map": "MAP10", "region": "Fire Shrine", "keys": ["key/InventoryWaterFigurine", "map/MAP10/Temple E Hall"] }
AP-REGION { "map": "MAP10", "region": "Magnetic Caves", "keys": ["map/MAP10/Fire Shrine"] }

; Water shrine. Hard requires fire figurine.
; Placing the fire figurine also lets you get the extra checks in the pillar room.
AP-REGION { "map": "MAP10", "region": "Water Shrine", "keys": ["map/MAP10/Temple W Hall", "key/InventoryFireFigurine"] }
AP-REGION { "map": "MAP10", "region": "Pillar Room Basement", "keys": ["flag/secret", "key/InventoryFireFigurine", "map/MAP10/Pillar Room"] }

; Earth shrine.
; Normally the first shrine you visit, using the air figurine.
; Can also backdoor into it via the magnetic caves, if you're careful about the poison.
AP-REGION { "map": "MAP10", "region": "Earth Shrine", "keys": ["map/MAP10/Temple E Hall", "key/InventoryAirFigurine"] }
AP-REGION { "map": "MAP10", "region": "Earth Shrine", "keys": ["map/MAP10/Magnetic Caves"] }

; On to the rest of the level!
AP-REGION { "map": "MAP10", "region": "Temple N Hall", "keys": ["key/InventoryEarthFragment", "key/InventoryWaterFragment", "key/InventoryFireFragment", "map/MAP10/Elemental Temple", "key/InventoryAirFragment"] }
AP-REGION { "map": "MAP10", "region": "Great Hall", "keys": ["map/MAP10/Temple N Hall"] }
AP-REGION { "map": "MAP10", "region": "Great Hall Stairs", "keys": ["map/MAP10/Great Hall"] }
AP-REGION { "map": "MAP10", "region": "Power Room W", "keys": ["map/MAP10/Great Hall Stairs", "weapon/HatchetAndShield/want", "weapon/SpikeGun/want"] }
AP-REGION { "map": "MAP10", "region": "Power Monitoring", "keys": ["map/MAP10/Power Room"] }
AP-REGION { "map": "MAP10", "region": "Power Room E", "keys": ["map/MAP10/Power Monitoring"] }
