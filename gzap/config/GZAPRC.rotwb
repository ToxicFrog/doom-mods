### Rise Of The Woll Ball Data ### By Xindage : (14/06/26-DD/MM/YY)
# The game is completed and this data uses 1.3 version of the game.

require E1M1 d6af5fcd914f7452789b1d58493b74e8;

# All maps are connected throught WORLDMAP events.
scanner {
  levels E1M1 E1M2 E1M3 E1M4 E1M5 E1M6 E2M1 E2M2 E2M3 E2M4 E2M5 E2M6 E3M1 E3M2 E3M3 E3M4 E3M5 E3M6;
  prune WORLDMAP TITLEMAP;
}

## Weapons
tag PistolNew Pistol;
tag ShotgunNew Shotgun;
tag ChaingunNew Chaingun;
tag RocketLauncherNew Cucumber launcher;
tag PewpRifle Bird gun;

