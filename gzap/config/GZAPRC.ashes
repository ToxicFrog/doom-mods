#### Ashes 2063 configuration ####
require MAP00 92a4314fb0847d33ab8559d637e7435d;

# Ashes does something weird here where it has a bunch of custom keys, but under
# the hood it uses the normal skull/keycard actors -- each key is a CustomInventory
# that when picked up gives you the corresponding vanilla key!
# This works, but also causes some confusing UI stuff at runtime because it results
# in AP picking up the originals as additional keys -- so e.g. MAP01, which has
# the BluePassCard, will give you a BlueCard once you pick it up, which will in
# turn result in it identifying that map as having both a BlueCard and a BluePassCard
# and you as having both of them. Which works, but is untidy.
# Replacing them with the underlying keycards or skulls avoids this, but at the
# cost of them no longer lining up with what the in-level messages say.
# Ideally we'd want some way of saying "treat a BlueCard in the player's inventory
# like a BluePassCard in the AP inventory, and vice versa", or something.
category key:
  BluePassCard RedPassCard YellowPassCard
  AshesSilverKey AshesBronzeKey AshesGoldKey;
replacement RedCard: RedPassCard;
replacement BlueCard: BluePassCard;
replacement YellowCard: YellowPassCard;
replacement BlueSkull: AshesSilverKey;
replacement RedSkull: AshesBronzeKey;
replacement YellowSkull: AshesGoldKey;

tag BlueSkull Silver Utility Key;
tag RedSkull Bronze Staff Key;
tag YellowSkull Gold Security Key;
tag RedCard Red Access Card;
tag BlueCard Blue Access Card;
tag YellowCard Yellow Access Card;

# Random health spawner. All the FoodTin1/2/3/4 are identical apart from graphics.
#
# TODO: maybe we want to be able to do something like:
# replacement FoodTin1 FoodTin2 FoodTin3 FoodTin4: CanneryReplacer;
# and it will randomly pick a replacement, but in a deterministic way based on
# coordinates or something, so it's consistent across scans?
replacement FoodTin1: CanneryReplacer;
tag FoodTin1 Food;

# The motorcycle is, internally, a weapon. This means that by default we will
# generate weapon grants for it, causing the player to re-equip it every time
# we apply weapon ownership...
category none: Motohandles;

# TODO: We need to figure out what to do about the .45 revolver. It spawns in
# your starting inventory (in 2063 only; not in DMW) so AP creates a universal
# weapon grant from it, but it's also placed in the world and thus present in
# the pool.
# Probably we need to implement an ap_no_pool category, which records locations
# but does not add their contents to the pool.
# category weapon-ap_filler-ap_no_pool: revolver;

# There's also various quest items which are autocategorized as "tools" and should
# instead be categorized as cross-level quest items.
# Some of these are given by ACS and not available to the scanner.
# Handling those properly likely requires the same sort of event support in the
# logic file that Faithless wants.
category key: QuestRadio QuestJerryCan QuestBriefcase QuestCodebook;

# 30s of health, double firing rate
category big-health-powerup: RegenStimpack;
category big-attack-powerup: Powerrage;
# radsuit, flashlight
category medium-tool: PurgeStimpack;
category big-useful-tool: LanternPickup;
tag LanternPickup Lantern;

# Money
# Medium sizes are 100. Small sizes are 1-20.
category small-token: Chips JUNKtools JUNKcable JUNKgear JUNKnuts JUNKpipe JUNKspares;
category medium-token: CollectibleGuitar CollectibleHissy CollectibleNMAcap;
tag JUNKtools Junk Tools;
tag JUNKcable Junk Cable;
tag JUNKgear Junk Gear;
tag JUNKnuts Junk Nuts;
tag JUNKpipe Junk Pipe;
tag JUNKspares Junk Spares;
tag CollectibleGuitar Collectible Guitar;
tag CollectibleHissy Collectible Hissy Doll;
tag CollectibleNMAcap Collectible NMA Cap;

# CrapJunk is evenly weighted between tools, cables, gear, nuts, pipe, or spares,
# with values [15, 15, 15, 10, 5, 20], for an EV of 13⅓.
# With this replacement rule we make it deterministic to reduce logic file churn.
replacement JUNKgear: CrapJunk;

# Ideally we do something like:
# replacement APJunk: CrapJunk;
# replacement CrapJunk: APJunk;
# tag APJunk Random Junk;
# category small-token: APJunk;
# and then define APJunk in ap_scripts.zs. However, then we need to have
# ap_scripts loaded when doing the scan, not just during gameplay.
# TODO: rename ap_scripts, ap_mapinfo to ZSCRIPT and MAPINFO so we can -file the
# wad support directory, then rename them when generating the pk3.
# (the same technique can be used for CanneryReplacer)

# Random loot
# Breaking a CONTCardbox, PropRubbishBag, or CONTTrashcan has a 120/255
# chance (box, bag) or 60/255 (can) of dropping a CrapJunk, giving us an EV of
# 3.1 for trash cans and 6.3 for the rest.
#
# If we wanted a sort of grass rando esque experience here where all of these
# contain checks, we either need a custom patch (so breaking them always drops
# checks) or some sort of replacement hack here.
#
# For now I'm just leaving them in-game as normal.
#
# The comedy option is to add them to the pool as-is, so receiving them through
# AP drops a breakable item at your feet that you then need to crack open to
# possibly get nothing at all.
#
# category small-token-breakable: CONTCardbox PropRubbishBag CONTTrashcan;
# replacement CrapJunk: CONTCardbox PropRubbishBag CONTTrashcan;
# category CrapJunk: small-token-breakable;
# tag CONTCardbox Cardboard Box;
# tag PropRubbishBag Rubbish Bag;
# tag CONTTrashcan Trash Can;

category big-ammo: pipebomb;

replacement pumpaction2: PumpySpawn PumpAction;
replacement Ingram3: IngramSpawn Ingram Ingram2;
# progressive PumpySpawn: pumpaction pumpaction2;
# progressive IngramSpawn: ingram ingram2 ingram3;

# Additionally, some weapons you are assumed to pick up from enemies...
prereqs {
  actor PistolThug AkimboRipper: weapon/Glock/auto;
  actor ShotgunThug ShotgunRipper: weapon/pumpaction2/auto;
}
